# Copiar como .env (misma carpeta) y completar. .env no se versiona.
# Lo usa supabase/config.toml ([auth.email.smtp]) al correr
# `supabase config push --project-ref shkdlkbhpkbrfxemctdj` desde esta carpeta.
# API key de Resend (API Keys → Create API Key, permiso "Sending access").
SMTP_PASS=re_reemplaza-por-tu-api-key
# Remitente de un dominio verificado en Resend (Domains → estado Verified).
SMTP_ADMIN_EMAIL=no-responder@tu-dominio.cl
