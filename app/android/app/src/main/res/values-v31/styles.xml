<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: pantalla de arranque del sistema vacía, solo con el
         fondo de la apertura. El primer cuadro de Flutter es ese mismo fondo, así
         que al entrar la animación de lanzamiento no hay salto. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_vacio</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>
</resources>
