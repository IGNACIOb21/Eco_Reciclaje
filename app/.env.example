# Copiar como .env (misma carpeta) y completar. .env no se versiona.
# Para Supabase local (`supabase start`) usar la IP del PC y el anon key que imprime.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=reemplaza-por-tu-publishable-key
# Token PÚBLICO de Mapbox (empieza con pk., cuenta Free Tier sin tarjeta).
# Nunca poner acá un token secreto (sk.).
MAPBOX_ACCESS_TOKEN=pk.reemplaza-por-tu-token-publico
